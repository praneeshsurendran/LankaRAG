# ─────────────────────────────────────────────────────────────────
#  LankaRAG — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  Never commit the actual .env file.
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL (matches docker-compose.yml defaults) ──────────────
POSTGRES_USER=lankarag
POSTGRES_PASSWORD=lankarag_secret
POSTGRES_DB=lankarag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full DSN (auto-built by config.py — override if using a managed DB)
# DATABASE_URL=postgresql+asyncpg://lankarag:lankarag_secret@localhost:5432/lankarag_db

# ── Pinecone ──────────────────────────────────────────────────────
# Get your key at: https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1   # Serverless region, e.g. us-east-1

# Two separate indexes (different embedding dimensions: 384 vs 512)
PINECONE_TEXT_INDEX=lankarag-text       # dimension=384 (all-MiniLM-L6-v2)
PINECONE_IMAGE_INDEX=lankarag-images    # dimension=512 (CLIP ViT-B/32)

# ── Google Gemini ─────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Backend Server ────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Frontend (Next.js public env vars must start with NEXT_PUBLIC_) ─
NEXT_PUBLIC_API_URL=http://localhost:8000
